---
import Base from "../layouts/Base.astro";
import { savorSite } from "../data/savor";
---

<Base
	title="Privacy Policy - Savor Restaurant"
	description="Privacy policy information for Savor Restaurant."
	image={savorSite.awardsBackground}
	pageClass="page-privacy"
>
	<section class="page-hero-band" style={`background-image: url('${savorSite.awardsBackground}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container page-hero-band__content">
			<h1>Privacy Policy</h1>
		</div>
	</section>

	<section class="live-section">
		<div class="container">
			<div class="live-copy" style="max-width: 860px; margin: 0 auto;">
				<p>
					Savor Restaurant respects your privacy. If you contact us through email, reservation
					platforms, or third-party ordering systems, we use the information you provide only to
					respond to your inquiry, manage your reservation or order, and improve guest service.
				</p>
				<p>
					Reservation and online ordering services are operated by third-party providers. Their
					data practices are governed by their own privacy policies, so please review those
					providers directly when using external booking or ordering links from this website.
				</p>
				<p>
					We may collect basic technical information such as browser type, device information, and
					general usage trends to understand how visitors use the website and to keep the site
					functioning properly.
				</p>
				<p>
					If you would like to ask a question about personal information connected to an inquiry,
					reservation, or event request, contact us at
					{" "}
					<a href={savorSite.emailHref}>{savorSite.email}</a>
					{" "}
					or call
					{" "}
					<a href={savorSite.phoneHref}>{savorSite.phoneDisplay}</a>.
				</p>
			</div>
		</div>
	</section>
</Base>
