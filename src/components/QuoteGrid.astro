---
interface QuoteCard {
	title?: string;
	quote?: string;
	source?: string;
}

interface Props {
	items: Array<{ data: QuoteCard }>;
}

const { items } = Astro.props;
---

{
	items.length > 0 && (
		<section class="quote-grid section-shell">
			<div class="section-heading">
				<p class="eyebrow">Testimonials</p>
				<h2>Guests come back for the food, the service, and the way the room feels.</h2>
			</div>
			<div class="quote-grid__layout">
				{items.map(({ data }) => (
					<blockquote class="quote-grid__card surface-card">
						<p class="quote-grid__quote">"{data.quote}"</p>
						<footer>
							<strong>{data.title}</strong>
							{data.source && <span>{data.source}</span>}
						</footer>
					</blockquote>
				))}
			</div>
		</section>
	)
}

<style>
	.quote-grid__layout {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.quote-grid__card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.quote-grid__quote {
		font-size: 1.02rem;
		color: var(--color-ink);
	}

	.quote-grid__card footer {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.quote-grid__layout {
			grid-template-columns: 1fr;
		}
	}
</style>
