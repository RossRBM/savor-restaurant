{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "savor-restaurant",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "savor-restaurant-em-dash",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "beb1a79a-5542-4c55-88ca-ba9316c76bc3",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "savor-restaurant-media","preview_bucket_name": "savor-restaurant-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
