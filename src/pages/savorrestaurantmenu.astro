---
import { getEmDashCollection } from "emdash";
import LambertAwards from "../components/LambertAwards.astro";
import Base from "../layouts/Base.astro";
import {
	dessertMenuSections,
	dinnerMenuSections,
	easterFeature,
	fallbackAwards,
	lunchMenuSections,
	menuSpecialCourses,
	savorSite,
	sortByOrder,
} from "../data/savor";

const { entries: menuEntries } = await getEmDashCollection("menu_items");
const { entries: awardEntries } = await getEmDashCollection("awards");

const awards = sortByOrder(awardEntries.length ? awardEntries : fallbackAwards);
const menuItems = sortByOrder(menuEntries);

const groupMenu = (sections: string[]) =>
	sections
		.map((section) => ({
			title: section.replace(/^Lunch /, "").replace(/^Dinner /, ""),
			items: menuItems.filter(
				(item) =>
					item.data.menu_page === "Restaurant Menu" && item.data.section === section,
			),
		}))
		.filter((section) => section.items.length > 0);

const lunchGroups = groupMenu(lunchMenuSections);
const dinnerGroups = groupMenu(dinnerMenuSections);
const dessertGroups = groupMenu(dessertMenuSections);
---

<Base
	title="Savor Restaurant | Real Food, Made Fresh | Full Menu & Specials"
	description="Explore Savor's lunch, dinner, dessert, and seasonal specials."
	image={savorSite.menuLunchBackground}
	pageClass="page-menu"
>
	<section class="page-hero-band" style={`background-image: url('${savorSite.menuLunchBackground}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container page-hero-band__content">
			<p class="live-hero__kicker">Savor Restaurant</p>
			<h1>Real Food, Made Fresh</h1>
			<p>
				Join us for lunch, dinner, dessert, and the house-made pasta dishes that made Savor a
				downtown Somerville favorite.
			</p>
			<div class="hero-actions">
				<a class="live-button" href={savorSite.reservationsUrl} target="_blank" rel="noreferrer">
					Reserve A Table
				</a>
				<a class="live-button live-button--ghost" href="#specials">Seasonal Specials</a>
			</div>
		</div>
	</section>

	<section class="menu-section" id="lunch">
		<div class="container">
			<nav class="menu-anchor-nav" aria-label="Menu sections">
				<a href="#lunch">Lunch</a>
				<a href="#dinner">Dinner</a>
				<a href="#dessert">Dessert</a>
				<a href="#specials">Specials</a>
			</nav>

			<div class="menu-section__heading">
				<h2>Lunch Menu</h2>
			</div>

			<div class="container-menu">
				<div class="mn-menu-holder">
					{lunchGroups.map((group) => (
						<>
							<div class="section-title-block section-title-block--center menu-section__heading">
								<h4>{group.title}</h4>
							</div>
							{group.items.map(({ data }) => (
								<div class="mn-menu-item">
									<div class="mn-menu-item-details">
										<div class="mn-menu-item-desc">
											{data.image_url ? (
												<a href={data.image_url} target="_blank" rel="noreferrer">
													{data.title}
												</a>
											) : (
												<span>{data.title}</span>
											)}
										</div>
										<div class="mn-menu-item-dot"></div>
										<div class="mn-menu-item-prices">
											<div class="mn-menu-item-price">
												{[data.price, data.secondary_price].filter(Boolean).join(" / ")}
											</div>
										</div>
									</div>
									{data.description && <p>{data.description}</p>}
								</div>
							))}
						</>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="page-hero-band" id="dinner" style={`background-image: url('${savorSite.menuDinnerBackground}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container page-hero-band__content">
			<h2>Dinner Menu</h2>
			<p>Italian American favorites, seafood, steaks, and Savor's house-made pasta specialties.</p>
		</div>
	</section>

	<section class="menu-section">
		<div class="container">
			<div class="container-menu">
				<div class="mn-menu-holder">
					{dinnerGroups.map((group) => (
						<>
							<div class="section-title-block section-title-block--center menu-section__heading">
								<h4>{group.title}</h4>
							</div>
							{group.items.map(({ data }) => (
								<div class="mn-menu-item">
									<div class="mn-menu-item-details">
										<div class="mn-menu-item-desc">
											{data.image_url ? (
												<a href={data.image_url} target="_blank" rel="noreferrer">
													{data.title}
												</a>
											) : (
												<span>{data.title}</span>
											)}
										</div>
										<div class="mn-menu-item-dot"></div>
										<div class="mn-menu-item-prices">
											<div class="mn-menu-item-price">
												{[data.price, data.secondary_price].filter(Boolean).join(" / ")}
											</div>
										</div>
									</div>
									{data.description && <p>{data.description}</p>}
								</div>
							))}
						</>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="page-hero-band" id="dessert" style={`background-image: url('${savorSite.menuDessertBackground}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container page-hero-band__content">
			<h2>Dessert Menu</h2>
			<p>Finish the meal with house-made desserts, gelato, and coffee service.</p>
		</div>
	</section>

	<section class="menu-section live-section--cream">
		<div class="container">
			<div class="container-menu">
				<div class="mn-menu-holder">
					{dessertGroups.map((group) => (
						<>
							<div class="section-title-block section-title-block--center menu-section__heading">
								<h4>{group.title}</h4>
							</div>
							{group.items.map(({ data }) => (
								<div class="mn-menu-item">
									<div class="mn-menu-item-details">
										<div class="mn-menu-item-desc">
											{data.image_url ? (
												<a href={data.image_url} target="_blank" rel="noreferrer">
													{data.title}
												</a>
											) : (
												<span>{data.title}</span>
											)}
										</div>
										<div class="mn-menu-item-dot"></div>
										<div class="mn-menu-item-prices">
											<div class="mn-menu-item-price">
												{[data.price, data.secondary_price].filter(Boolean).join(" / ")}
											</div>
										</div>
									</div>
									{data.description && <p>{data.description}</p>}
								</div>
							))}
						</>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="live-section" id="specials">
		<div class="container">
			<div class="live-special-feature">
				<div class="live-special-feature__image">
					<img src={easterFeature.image} alt="Savor seasonal menu artwork" loading="lazy" />
				</div>
				<div class="live-special-feature__card">
					<p class="live-special-feature__eyebrow">{easterFeature.eyebrow}</p>
					<h2>{easterFeature.title}</h2>
					<ul class="live-special-feature__details">
						{easterFeature.details.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					<div class="live-actions">
						<a
							class="live-button"
							href={easterFeature.button.url}
							target={easterFeature.button.target}
							rel={easterFeature.button.target === "_blank" ? "noreferrer" : undefined}
						>
							{easterFeature.button.label}
						</a>
						<a class="live-button live-button--dark" href="/takeout-catering/">
							Takeout Catering
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="live-section live-specials">
		<div class="container">
			<div class="section-title-block section-title-block--light section-title-block--center">
				<h2>Father's Day Menu</h2>
				<p>
					Open from Noon to 8:00 on June 18th, 2023
					<br />
					(please note this menu is in addition to our regular menu)
				</p>
			</div>
			<div class="special-course-grid">
				{menuSpecialCourses.map((course) => (
					<article class="special-course-card">
						<h3>{course.title}</h3>
						<ul>
							{course.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<LambertAwards
		awards={awards}
		backgroundImage={savorSite.awardsBackground}
		headline="Voted Best Fine Dining in Somerset County"
		subheadline="Voted Best BYOB in Somerset County"
	/>
</Base>
