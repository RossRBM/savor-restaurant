---
interface Props {
	eyebrow?: string | null;
	title?: string | null;
	intro?: string | null;
	image?: string | null;
	primaryLabel?: string | null;
	primaryUrl?: string | null;
	secondaryLabel?: string | null;
	secondaryUrl?: string | null;
}

const {
	eyebrow,
	title,
	intro,
	image,
	primaryLabel,
	primaryUrl,
	secondaryLabel,
	secondaryUrl,
} = Astro.props;
---

<section class="page-hero">
	<div class="page-hero__shell">
		<div class="page-hero__copy">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			{intro && <p class="page-hero__intro">{intro}</p>}
			{(primaryLabel && primaryUrl) || (secondaryLabel && secondaryUrl) ? (
				<div class="page-hero__actions">
					{primaryLabel && primaryUrl && (
						<a class="button" href={primaryUrl}>
							{primaryLabel}
						</a>
					)}
					{secondaryLabel && secondaryUrl && (
						<a class="button button-secondary" href={secondaryUrl}>
							{secondaryLabel}
						</a>
					)}
				</div>
			) : null}
		</div>
		{image && (
			<div class="page-hero__media surface-card">
				<img src={image} alt={title || "Savor Restaurant"} loading="eager" />
			</div>
		)}
	</div>
</section>

<style>
	.page-hero {
		padding: clamp(4.5rem, 8vw, 7rem) 1.5rem 2rem;
	}

	.page-hero__shell {
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
	}

	.page-hero__copy h1 {
		font-size: clamp(2.8rem, 5vw, 5.2rem);
		line-height: 0.94;
		max-width: 12ch;
	}

	.page-hero__intro {
		max-width: 58ch;
		margin-top: 1.4rem;
		font-size: 1.05rem;
		color: var(--color-muted);
	}

	.page-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 1.8rem;
	}

	.page-hero__media {
		padding: 0;
		overflow: hidden;
		min-height: 420px;
	}

	.page-hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	@media (max-width: 900px) {
		.page-hero {
			padding-top: 3rem;
		}

		.page-hero__shell {
			grid-template-columns: 1fr;
		}

		.page-hero__copy h1 {
			max-width: 14ch;
		}

		.page-hero__media {
			min-height: 280px;
		}
	}
</style>
