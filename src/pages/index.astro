---
import { getEmDashCollection } from "emdash";
import LambertAwards from "../components/LambertAwards.astro";
import Base from "../layouts/Base.astro";
import {
	fallbackAwards,
	fallbackTeamMembers,
	fallbackTestimonials,
	homeAboutCopy,
	homeAboutRestaurant,
	homeCateringSlides,
	homeFoodSlides,
	homeHeroLinks,
	homeTeamIntro,
	savorSite,
	socialLinks,
	sortByOrder,
	specialsPanels,
} from "../data/savor";

const { entries: awardEntries } = await getEmDashCollection("awards");
const { entries: testimonialEntries } = await getEmDashCollection("testimonials");
const { entries: teamEntries } = await getEmDashCollection("team_members");

const awards = sortByOrder(awardEntries.length ? awardEntries : fallbackAwards);
const testimonials = sortByOrder(
	testimonialEntries.length ? testimonialEntries : fallbackTestimonials,
);
const teamMembers = sortByOrder(
	teamEntries.length ? teamEntries : fallbackTeamMembers,
).slice(0, 4);
---

<Base
	title="Savor Restaurant | Somerville NJ | Voted Best BYOB | Open Daily"
	description={savorSite.tagline}
	image={savorSite.homeHero}
	transparentHeader
	pageClass="page-home"
>
	<section class="lambert-hero" style={`background-image: url('${savorSite.homeHero}');`}>
		<div class="container lambert-hero__inner">
			<img
				src={savorSite.heroLogo}
				alt={savorSite.name}
				class="lambert-hero__logo"
				loading="eager"
			/>
			<p class="lambert-hero__location">{savorSite.location}</p>
			<div class="lambert-hero__actions">
				{homeHeroLinks.map((item) => (
					<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noreferrer" : undefined}>
						{item.label}
					</a>
				))}
			</div>
			<ul class="social-strip lambert-hero__social">
				{socialLinks.map((item) => (
					<li>
						<a href={item.url} target="_blank" rel="noreferrer" aria-label={item.label}>
							{item.shortLabel}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="content-section">
		<div class="container two-column">
			<div class="stacked-copy">
				<div class="section-title-block">
					<h4>CATER WITH SAVOR</h4>
				</div>
				<p>
					Are you planning a special event and looking for the perfect venue to host it at? Look
					no further than Savor, the premier fine dining restaurant serving delicious Italian
					cuisine.
				</p>
				<p>
					Our intimate and sophisticated setting is perfect for any occasion, from baby showers to
					corporate meetings.
				</p>
				<p>
					And with our special catering packages, you can treat your guests to a truly memorable
					dining experience. From baptisms to birthdays, Savor has you covered for all of life's
					special moments.
				</p>
				<p>
					<a class="button-link button-link--accent" href="/cateringeventvenue/">
						Explore Catering and Private Events
					</a>
				</p>
			</div>

			<div class="fade-slides" aria-hidden="true">
				{homeCateringSlides.map((image) => (
					<div class="fade-slides__item">
						<img src={image.src} alt={image.alt} loading="lazy" />
					</div>
				))}
			</div>
		</div>
	</section>

	<LambertAwards
		awards={awards}
		backgroundImage={savorSite.awardsBackground}
		headline="Voted Best Fine Dining in Somerset County"
		subheadline="Voted Best BYOB and Banquet Facility in Somerset County"
	/>

	<section class="triangle-section">
		<div class="container two-column two-column--reverse">
			<div class="stacked-copy">
				<div class="section-title-block">
					<h4>Real Food, Made Fresh</h4>
				</div>
				{homeAboutCopy.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<p>
					<a class="button-link" href="/savorrestaurantmenu/">
						View Full Lunch and Dinner Menus
					</a>
				</p>
			</div>

			<div class="fade-slides" aria-hidden="true">
				{homeFoodSlides.map((image) => (
					<div class="fade-slides__item">
						<img src={image.src} alt={image.alt} loading="lazy" />
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="parallax-band" style={`background-image: url('${savorSite.testimonialsBackground}');`} id="reviews">
		<div class="parallax-band__overlay"></div>
		<div class="container parallax-band__content">
			<div class="section-title-block section-title-block--light section-title-block--center">
				<h2>TESTIMONIALS</h2>
			</div>
			<div class="review-grid">
				{testimonials.map(({ data }) => (
					<article class="review-card">
						<div class="star-row" aria-hidden="true">
							<span>*</span>
							<span>*</span>
							<span>*</span>
							<span>*</span>
							<span>*</span>
						</div>
						<p>"{data.quote}"</p>
						<h3>{data.title}</h3>
					</article>
				))}
			</div>
			<p class="reviews-links">
				More Reviews at:
				{" "}
				<a href={savorSite.facebookUrl} target="_blank" rel="noreferrer">Facebook</a>
				{" "}
				|
				{" "}
				<a href={savorSite.tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a>
				{" "}
				|
				{" "}
				<a href="https://www.google.com/search?q=savor+somerville+nj" target="_blank" rel="noreferrer">
					Google
				</a>
			</p>
		</div>
	</section>

	<section class="triangle-section">
		<div class="container">
			<div class="section-title-block section-title-block--center">
				<h4>ABOUT SAVOR RESTAURANT</h4>
				<p>{homeAboutRestaurant}</p>
				<h4>EXPERT SERVICE STAFF</h4>
				<p>{homeTeamIntro}</p>
			</div>

			<div class="team-grid">
				{teamMembers.map(({ data }) => (
					<article class="team-card">
						<img src={data.image_url} alt={data.title || "Savor team member"} loading="lazy" />
						<div class="team-card__body">
							<h3>{data.title}</h3>
							<p class="team-card__role">{data.role}</p>
							<p>{data.bio}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="content-section" id="specials">
		<div class="container">
			<div class="callout-strip">PRIVATE EVENTS &amp; TAKE OUT | INQUIRE NOW</div>
			<div class="section-title-block section-title-block--center" style="margin-top: 2rem;">
				<h4>Special Menus</h4>
				<p>
					Savor rotates holiday, weekend, and private event specials throughout the year. Call or
					email for the most current features and event menu options.
				</p>
			</div>
			<div class="specials-grid">
				{specialsPanels.map((panel) => (
					<article class="special-card">
						<h3>{panel.title}</h3>
						<p>{panel.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>
</Base>
