---
import { decodeSlug, getEmDashCollection, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import ContactPanel from "../components/ContactPanel.astro";
import MenuBoard from "../components/MenuBoard.astro";
import PageHero from "../components/PageHero.astro";
import {
	cateringSectionOrder,
	menuSectionDescriptions,
	restaurantSectionOrder,
	roomTours,
	savorSite,
	venueGalleries,
} from "../data/savor";
import Base from "../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

if (slug === "home") {
	return Astro.redirect("/");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

try {
	Astro.cache.set(cacheHint);
} catch {}

const template = page.data.template || "Standard";
const needsMenu = template === "Menu" || template === "Catering";
const { entries: allMenuItems } = needsMenu
	? await getEmDashCollection("menu_items")
	: { entries: [] };

const sortEntries = <T extends { data: { sort_order?: number } }>(entries: T[]) =>
	entries.toSorted((a, b) => (a.data.sort_order || 0) - (b.data.sort_order || 0));

const sortedMenuItems = sortEntries(allMenuItems);

const restaurantSections = restaurantSectionOrder
	.map((section) => ({
		title: section,
		items: sortedMenuItems.filter(
			(item) =>
				item.data.menu_page === "Restaurant Menu" &&
				item.data.section === section,
		),
	}))
	.filter((section) => section.items.length > 0);

const cateringSections = cateringSectionOrder
	.map((section) => ({
		title: section,
		description: menuSectionDescriptions[section],
		items: sortedMenuItems.filter(
			(item) =>
				item.data.menu_page === "Takeout Catering" &&
				item.data.section === section,
		),
	}))
	.filter((section) => section.items.length > 0);

const gallery = venueGalleries[slug] || [];
const tours = roomTours[slug] || [];
---

<Base title={page.data.title} description={page.data.intro || savorSite.tagline}>
	<PageHero
		eyebrow={page.data.eyebrow}
		title={page.data.headline || page.data.title}
		intro={page.data.intro}
		image={page.data.hero_image}
		primaryLabel={page.data.primary_cta_label}
		primaryUrl={page.data.primary_cta_url}
		secondaryLabel={page.data.secondary_cta_label}
		secondaryUrl={page.data.secondary_cta_url}
	/>

	{
		template === "Menu" && (
			<>
				<section class="page-section section-shell">
					<div class="surface-card page-copy">
						{page.data.body && <PortableText value={page.data.body} />}
					</div>
				</section>
				<MenuBoard sections={restaurantSections} />
				<ContactPanel
					title="Reservations are recommended for dinner, weekends, and special holiday menus."
					description="Planning a date night, family dinner, or larger gathering? We’ll help you time it right."
				/>
			</>
		)
	}

	{
		template === "Catering" && (
			<>
				<section class="page-section section-shell">
					<div class="surface-card page-copy">
						{page.data.body && <PortableText value={page.data.body} />}
						<div class="download-links">
							<a class="button" href="/files/Savor-Lunch-Catering.pdf">
								Download Lunch Catering Menu
							</a>
							<a class="button button-secondary" href="/files/Savor-Dinner-Catering.pdf">
								Download Dinner Catering Menu
							</a>
						</div>
					</div>
				</section>
				<MenuBoard sections={cateringSections} />
				<ContactPanel
					title="Takeout catering is priced for easy pickup and flexible hosting."
					description="Half trays serve 10 to 12 guests. Full trays serve 20 to 25 guests."
				/>
			</>
		)
	}

	{
		template === "Events" && (
			<>
				<section class="page-section section-shell">
					<div class="surface-card page-copy">
						{page.data.body && <PortableText value={page.data.body} />}
					</div>
				</section>
				{gallery.length > 0 && (
					<section class="section-shell">
						<div class="section-heading">
							<p class="eyebrow">Inside the Rooms</p>
							<h2>Choose a space that feels polished, warm, and easy to host in.</h2>
						</div>
						<div class="gallery-grid">
							{gallery.map((image) => (
								<div class="surface-card gallery-grid__item">
									<img src={image.src} alt={image.alt} loading="lazy" />
								</div>
							))}
						</div>
					</section>
				)}
				{tours.length > 0 && (
					<section class="section-shell">
						<div class="section-heading">
							<p class="eyebrow">Virtual Tours</p>
							<h2>Walk through the rooms before you book.</h2>
						</div>
						<div class="tour-grid">
							{tours.map((tour) => (
								<article class="surface-card tour-card">
									<div class="tour-card__frame">
										<iframe src={tour.url} title={tour.title} loading="lazy" allowfullscreen />
									</div>
									<h3>{tour.title}</h3>
									<p>{tour.description}</p>
								</article>
							))}
						</div>
					</section>
				)}
				<ContactPanel
					title="Tell us about your guest count, timing, and the kind of event you’re planning."
					description="We host showers, repasts, birthdays, rehearsal dinners, business dinners, and more."
				/>
			</>
		)
	}

	{
		template === "Delivery" && (
			<>
				<section class="page-section section-shell">
					<div class="page-grid">
						<div class="surface-card page-copy">
							{page.data.body && <PortableText value={page.data.body} />}
							<div class="download-links">
								<a class="button" href={savorSite.orderUrl} target="_blank" rel="noreferrer">
									Order Online
								</a>
								<a class="button button-secondary" href="/savorrestaurantmenu/">
									View Full Menu
								</a>
							</div>
						</div>
						<div class="surface-card delivery-sidebar">
							<h3>Restaurant Info</h3>
							<ul>
								<li>{savorSite.address}</li>
								<li>{savorSite.phoneDisplay}</li>
								<li>{savorSite.email}</li>
								<li>{savorSite.hours}</li>
								<li>{savorSite.lunchHours}</li>
								<li>{savorSite.lastSeating}</li>
							</ul>
							<div class="download-links">
								<a href={savorSite.parkingMapUrl}>Parking location map</a>
								<a href={savorSite.parkingAppUrl} target="_blank" rel="noreferrer">
									Parking app information
								</a>
							</div>
						</div>
					</div>
				</section>
				<ContactPanel
					title="Want the dining room experience instead?"
					description="Reserve a table for lunch or dinner, or call us if you need help with a larger takeout order."
				/>
			</>
		)
	}

	{
		(template === "Policy" || template === "Standard") && (
			<section class="page-section section-shell">
				<div class="surface-card page-copy page-copy--narrow">
					{page.data.body && <PortableText value={page.data.body} />}
				</div>
			</section>
		)
	}
</Base>

<style>
	.page-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 1rem;
	}

	.page-copy,
	.delivery-sidebar {
		display: grid;
		gap: 1rem;
	}

	.page-copy--narrow {
		max-width: 860px;
		margin: 0 auto;
	}

	.download-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		align-items: center;
	}

	.gallery-grid,
	.tour-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.gallery-grid__item {
		padding: 0;
		overflow: hidden;
	}

	.gallery-grid__item img {
		width: 100%;
		aspect-ratio: 16 / 11;
		object-fit: cover;
		display: block;
	}

	.tour-card {
		display: grid;
		gap: 0.8rem;
	}

	.tour-card__frame {
		overflow: hidden;
		border-radius: 18px;
	}

	.tour-card iframe {
		width: 100%;
		height: 280px;
		border: 0;
		display: block;
	}

	.delivery-sidebar ul {
		display: grid;
		gap: 0.6rem;
		padding-left: 1rem;
		color: var(--color-muted);
	}

	@media (max-width: 980px) {
		.page-grid,
		.gallery-grid,
		.tour-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
