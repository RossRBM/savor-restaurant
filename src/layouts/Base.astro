---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { footerLinks, fallbackPrimaryMenu, savorSite } from "../data/savor";
import "../styles/theme.css";

interface Props {
	title?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, description, image, canonical, content } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || savorSite.name;
const siteTagline = settings?.tagline || savorSite.tagline;
const siteFavicon = null;
const fullTitle =
	title && title !== siteTitle ? `${title} | ${siteTitle}` : siteTitle;
const menu = await getMenu("primary");
const navItems = menu?.items?.length ? menu.items : fallbackPrimaryMenu;
const footerMenu = navItems?.length ? navItems : footerLinks;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteTagline,
	canonical: canonical || Astro.url.href,
	image,
	content,
	seo: { ogImage: image || undefined },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" />
		<title>{fullTitle}</title>
		{siteFavicon && <link rel="icon" href={siteFavicon} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav container">
				<a href="/" class="site-logo" aria-label={siteTitle}>
					<img src={savorSite.logo} alt={siteTitle} class="site-logo-img" />
					<div class="site-logo-copy">
						<strong>{siteTitle}</strong>
						<span>Somerville, New Jersey</span>
					</div>
				</a>
				<div class="nav-links">
					{navItems.map((item) => (
						<a href={item.url} target={item.target}>
							{item.label}
						</a>
					))}
				</div>
				<div class="nav-actions">
					<a
						href={savorSite.reservationsUrl}
						class="button button-secondary button-small"
						target="_blank"
						rel="noreferrer"
					>
						Reservations
					</a>
					<a href="/delivery-menu/" class="button button-small">
						Order
					</a>
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
				</div>
				<details class="mobile-nav">
					<summary>Menu</summary>
					<div class="mobile-nav__panel surface-card">
						{navItems.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))}
						<a href={savorSite.reservationsUrl} target="_blank" rel="noreferrer">
							Reservations
						</a>
						<a href="/delivery-menu/">Order</a>
						{isLoggedIn && <a href="/_emdash/admin">Admin</a>}
					</div>
				</details>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-grid">
				<div class="footer-brand">
					<img src={savorSite.logo} alt={siteTitle} class="footer-logo-img" />
					<p>{siteTagline}</p>
				</div>
				<div>
					<h3>Navigate</h3>
					<ul class="footer-links">
						{footerMenu.map((item) => (
							<li>
								<a href={item.url} target={item.target}>{item.label}</a>
							</li>
						))}
					</ul>
				</div>
				<div>
					<h3>Visit</h3>
					<ul class="footer-links">
						<li>{savorSite.address}</li>
						<li><a href={savorSite.phoneHref}>{savorSite.phoneDisplay}</a></li>
						<li><a href={savorSite.emailHref}>{savorSite.email}</a></li>
						<li>{savorSite.hours}</li>
					</ul>
				</div>
				<div>
					<h3>Elsewhere</h3>
					<ul class="footer-links">
						<li><a href={savorSite.instagramUrl} target="_blank" rel="noreferrer">Instagram</a></li>
						<li><a href={savorSite.facebookUrl} target="_blank" rel="noreferrer">Facebook</a></li>
						<li><a href={savorSite.tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></li>
						<li><a href={savorSite.giftCardUrl} target="_blank" rel="noreferrer">Gift Cards</a></li>
						{isLoggedIn && <li><a href="/_emdash/admin">Admin</a></li>}
					</ul>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>&copy; {new Date().getFullYear()} {siteTitle}. Powered by EmDash on Cloudflare.</p>
			</div>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
