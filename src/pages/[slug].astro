---
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { legacyRedirects, savorSite } from "../data/savor";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

if (slug === "home") {
	return Astro.redirect("/");
}

if (legacyRedirects[slug]) {
	return Astro.redirect(legacyRedirects[slug], 301);
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

try {
	Astro.cache.set(cacheHint);
} catch {}

const title = page.data.title || savorSite.name;
const intro = page.data.intro || savorSite.tagline;
const heroImage = page.data.hero_image || savorSite.awardsBackground;
---

<Base
	title={title}
	description={intro}
	image={heroImage}
	pageClass="page-inner"
	content={{ collection: "pages", id: page.id, slug: page.slug }}
>
	<section class="page-hero-band" style={`background-image: url('${heroImage}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container page-hero-band__content">
			<div class="section-title-block section-title-block--light section-title-block--center">
				<h1>{page.data.headline || title}</h1>
				{page.data.intro && <p>{page.data.intro}</p>}
			</div>
		</div>
	</section>

	<section class="generic-page">
		<div class="container">
			<div class="generic-page__body">
				{page.data.body ? <PortableText value={page.data.body} /> : <p>{intro}</p>}
			</div>
		</div>
	</section>
</Base>
