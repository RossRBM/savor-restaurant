---
interface TeamCard {
	title?: string;
	role?: string;
	bio?: string;
	image_url?: string;
}

interface Props {
	items: Array<{ data: TeamCard }>;
}

const { items } = Astro.props;
---

{
	items.length > 0 && (
		<section class="staff-highlights section-shell">
			<div class="section-heading">
				<p class="eyebrow">Meet the Team</p>
				<h2>Owner-led hospitality backed by an experienced events and dining staff.</h2>
			</div>
			<div class="staff-highlights__grid">
				{items.map(({ data }) => (
					<article class="staff-highlights__card surface-card">
						{data.image_url && (
							<img src={data.image_url} alt={data.title || "Savor team member"} loading="lazy" />
						)}
						<div class="staff-highlights__content">
							<h3>{data.title}</h3>
							{data.role && <p class="staff-highlights__role">{data.role}</p>}
							{data.bio && <p>{data.bio}</p>}
						</div>
					</article>
				))}
			</div>
		</section>
	)
}

<style>
	.staff-highlights__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.staff-highlights__card {
		padding: 0;
		overflow: hidden;
	}

	.staff-highlights__card img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		display: block;
	}

	.staff-highlights__content {
		padding: 1.15rem;
	}

	.staff-highlights__role {
		margin-top: 0.35rem;
		margin-bottom: 0.8rem;
		color: var(--color-accent);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.76rem;
	}

	.staff-highlights__content p:last-child {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	@media (max-width: 1050px) {
		.staff-highlights__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 680px) {
		.staff-highlights__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
