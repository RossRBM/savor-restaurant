---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import AwardRibbon from "../components/AwardRibbon.astro";
import ContactPanel from "../components/ContactPanel.astro";
import MenuBoard from "../components/MenuBoard.astro";
import PageHero from "../components/PageHero.astro";
import QuoteGrid from "../components/QuoteGrid.astro";
import StaffHighlights from "../components/StaffHighlights.astro";
import { homeHighlights, homeMoments, savorSite } from "../data/savor";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
const { entries: menuItems } = await getEmDashCollection("menu_items");
const { entries: testimonials } = await getEmDashCollection("testimonials");
const { entries: teamMembers } = await getEmDashCollection("team_members");
const { entries: awards } = await getEmDashCollection("awards");

try {
	Astro.cache.set(cacheHint);
} catch {}

const sortEntries = <T extends { data: { sort_order?: number } }>(entries: T[]) =>
	entries.toSorted((a, b) => (a.data.sort_order || 0) - (b.data.sort_order || 0));

const featuredDishes = sortEntries(menuItems)
	.filter((item) => item.data.featured)
	.slice(0, 6);
---

<Base
	title={page?.data.title || savorSite.name}
	description={page?.data.intro || savorSite.tagline}
>
	{
		page ? (
			<>
				<PageHero
					eyebrow={page.data.eyebrow}
					title={page.data.headline || page.data.title}
					intro={page.data.intro}
					image={page.data.hero_image}
					primaryLabel={page.data.primary_cta_label}
					primaryUrl={page.data.primary_cta_url}
					secondaryLabel={page.data.secondary_cta_label}
					secondaryUrl={page.data.secondary_cta_url}
				/>

				<AwardRibbon awards={sortEntries(awards)} />

				<section class="home-story section-shell">
					<div class="section-heading">
						<p class="eyebrow">Real Food, Made Fresh</p>
						<h2>Italian American favorites, intimate rooms, and a team that knows how to host.</h2>
					</div>
					<div class="home-story__grid">
						<div class="surface-card home-story__copy">
							<ul class="home-story__highlights">
								{homeHighlights.map((item) => <li>{item}</li>)}
							</ul>
							{page.data.body && <PortableText value={page.data.body} />}
						</div>
						<div class="home-story__gallery">
							{homeMoments.map((image) => (
								<div class="surface-card home-story__image">
									<img src={image.src} alt={image.alt} loading="lazy" />
								</div>
							))}
						</div>
					</div>
				</section>

				<MenuBoard
					sections={[
						{
							title: "Dining Room Favorites",
							description:
								"A few of the house favorites guests come back for, from fresh pasta to signature starters.",
							items: featuredDishes,
						},
					]}
				/>

				<QuoteGrid items={sortEntries(testimonials).slice(0, 3)} />

				<section class="home-events section-shell">
					<div class="surface-card home-events__card">
						<div>
							<p class="eyebrow">Private Events</p>
							<h2>Host showers, rehearsal dinners, repasts, birthdays, and business dinners at Savor.</h2>
							<p>
								Our experienced team works closely with you on the room, the pacing, and a menu that fits the occasion.
							</p>
						</div>
						<div class="home-events__actions">
							<a class="button" href="/privateeventvenu/">Private Events</a>
							<a class="button button-secondary" href="/businessprivateeventvenue/">
								Corporate Events
							</a>
						</div>
					</div>
				</section>

				<StaffHighlights items={sortEntries(teamMembers)} />

				<ContactPanel />
			</>
		) : (
			<section class="section-shell">
				<div class="empty-state surface-card">
					<h1>Open the EmDash admin to finish setup.</h1>
					<p>This site expects the Savor seed content to be applied to the connected database.</p>
					<a class="button" href="/_emdash/admin">Open Admin</a>
				</div>
			</section>
		)
	}
</Base>

<style>
	.home-story__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.95fr);
		gap: 1rem;
	}

	.home-story__copy {
		display: grid;
		gap: 1.2rem;
	}

	.home-story__highlights {
		display: grid;
		gap: 0.75rem;
		padding-left: 1rem;
		color: var(--color-ink);
	}

	.home-story__gallery {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.home-story__image {
		padding: 0;
		overflow: hidden;
	}

	.home-story__image:first-child {
		grid-column: 1 / -1;
	}

	.home-story__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.home-events__card {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1.5rem;
		align-items: center;
	}

	.home-events__card p:last-child {
		max-width: 54ch;
		color: var(--color-muted);
	}

	.home-events__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	@media (max-width: 920px) {
		.home-story__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.home-story__gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
