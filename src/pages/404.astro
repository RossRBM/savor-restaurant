---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="live-section">
		<div class="not-found" style="max-width: 760px; margin: 0 auto;">
			<p class="live-tagline">404</p>
			<h1>That page is not on the menu.</h1>
			<p>The link may have moved during the WordPress to EmDash rebuild.</p>
			<a class="live-button" href="/">Back to Savor</a>
		</div>
	</section>
</Base>

<style>
	.not-found {
		text-align: center;
		padding: 3rem;
	}

	.not-found h1 {
		margin: 0.4rem 0 0.8rem;
	}

	.not-found p {
		margin-bottom: 1.2rem;
	}
</style>
