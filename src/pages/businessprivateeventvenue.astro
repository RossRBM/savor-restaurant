---
import { getEmDashCollection } from "emdash";
import LambertAwards from "../components/LambertAwards.astro";
import VenueTours from "../components/VenueTours.astro";
import Base from "../layouts/Base.astro";
import {
	businessHighlights,
	eventVenueCopy,
	fallbackAwards,
	savorSite,
	sortByOrder,
	venueSlides,
	venueTours,
} from "../data/savor";

const { entries: awardEntries } = await getEmDashCollection("awards");
const awards = sortByOrder(awardEntries.length ? awardEntries : fallbackAwards);
---

<Base
	title="Corporate & Business Private Event Venue | Savor Restaurant"
	description="Host business dinners, client gatherings, and company celebrations in Savor's private rooms in downtown Somerville."
	image={savorSite.corporateBackground}
	pageClass="page-inner"
>
	<section class="content-section">
		<div class="container content-grid">
			<div class="content-stack">
				{businessHighlights.map((item) => (
					<article class="content-card">
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>

			<div class="video-card">
				<iframe
					src="https://www.youtube.com/embed/8BrFgjtiSAw"
					title="Discover fine dining and flawless event experiences at Savor Restaurant"
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				/>
			</div>
		</div>
	</section>

	<section class="content-section">
		<div class="container">
			<div class="callout-strip">PRIVATE EVENTS &amp; TAKE OUT | INQUIRE NOW</div>
		</div>
	</section>

	<VenueTours
		title="Choose from three rooms holding between 14 and 80 people"
		backgroundImage={savorSite.corporateBackground}
		tours={venueTours}
	/>

	<section class="content-section">
		<div class="container two-column">
			<div class="stacked-copy">
				<div class="section-title-block">
					<h4>PRIVATE EVENT VENUE</h4>
				</div>
				{eventVenueCopy.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<p>
					<a class="button-link button-link--accent" href={savorSite.emailHref}>
						Plan a Corporate Event
					</a>
				</p>
			</div>

			<div class="fade-slides" aria-hidden="true">
				{venueSlides.map((image) => (
					<div class="fade-slides__item">
						<img src={image.src} alt={image.alt} loading="lazy" />
					</div>
				))}
			</div>
		</div>
	</section>

	<LambertAwards
		awards={awards}
		backgroundImage={savorSite.awardsBackground}
		headline="Voted Best Fine Dining in Somerset County"
		subheadline="Voted Best BYOB and Banquet Facility in Somerset County"
	/>
</Base>
