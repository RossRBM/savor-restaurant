---
import { getEmDashCollection } from "emdash";
import LambertAwards from "../components/LambertAwards.astro";
import Base from "../layouts/Base.astro";
import {
	easterFeature,
	fallbackAwards,
	fallbackTeamMembers,
	fallbackTestimonials,
	homeAboutCopy,
	homeAboutRestaurant,
	homeEventIntro,
	homeFoodSlides,
	homeHeroLinks,
	homeInstagramPosts,
	homeTeamIntro,
	menuSpecialCourses,
	savorSite,
	sortByOrder,
	socialLinks,
} from "../data/savor";

const { entries: awardEntries } = await getEmDashCollection("awards");
const { entries: testimonialEntries } = await getEmDashCollection("testimonials");
const { entries: teamEntries } = await getEmDashCollection("team_members");

const awards = sortByOrder(awardEntries.length ? awardEntries : fallbackAwards);
const testimonials = sortByOrder(
	testimonialEntries.length ? testimonialEntries : fallbackTestimonials,
);
const teamMembers = sortByOrder(
	teamEntries.length ? teamEntries : fallbackTeamMembers,
).slice(0, 4);
---

<Base
	title="Savor Restaurant | Somerville NJ | Voted Best BYOB | Open Daily"
	description={savorSite.tagline}
	image={savorSite.homeHero}
	pageClass="page-home"
>
	<section class="live-hero" style={`background-image: url('${savorSite.homeHero}');`}>
		<div class="container live-hero__content">
			<p class="live-hero__kicker">Somerville NJ</p>
			<h1 class="live-hero__title">Savor Restaurant</h1>
			<p class="live-hero__subtitle">{savorSite.tagline}</p>
			<div class="hero-actions">
				{homeHeroLinks.map((item) => (
					<a
						class:list={["live-button", item.label === "ORDER NOW" && "live-button--ghost"]}
						href={item.url}
						target={item.target}
						rel={item.target === "_blank" ? "noreferrer" : undefined}
					>
						{item.label}
					</a>
				))}
			</div>
			<div class="hero-actions" style="margin-top: 1rem;">
				{socialLinks.map((item) => (
					<a href={item.url} target="_blank" rel="noreferrer" aria-label={item.label}>
						<i class={`${item.icon} fa-lg`} aria-hidden="true"></i>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="live-section">
		<div class="container live-split">
			<div class="live-copy">
				<p class="live-tagline">Private Events</p>
				<div class="section-title-block">
					<h2>{homeEventIntro.title}</h2>
					<p>{homeEventIntro.lead}</p>
				</div>
				<p class="live-highlight">{homeEventIntro.highlight}</p>
				{homeEventIntro.body.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<div class="live-actions" style="justify-content: flex-start;">
					<a class="live-button" href="/privateeventvenu/">
						Private Event Venue
					</a>
					<a class="live-button live-button--dark" href="/takeout-catering/">
						Takeout Catering
					</a>
				</div>
			</div>

			<div class="live-split__image">
				<img src={homeEventIntro.image} alt="Private event venue at Savor Restaurant" loading="eager" />
			</div>
		</div>
	</section>

	<LambertAwards
		awards={awards}
		backgroundImage={savorSite.awardsBackground}
		headline="Voted Best Fine Dining in Somerset County"
		subheadline="Voted Best BYOB in Somerset County"
	/>

	<section class="live-section live-section--cream">
		<div class="container live-split live-split--reverse">
			<div class="live-copy">
				<p class="live-tagline">Menu</p>
				<div class="section-title-block">
					<h2>Real Food, Made Fresh</h2>
				</div>
				{homeAboutCopy.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<div class="live-actions" style="justify-content: flex-start;">
					<a class="live-button" href="/savorrestaurantmenu/">
						View Full Lunch and Dinner Menus
					</a>
				</div>
			</div>

			<div class="live-split__image">
				<img src={homeFoodSlides[0].src} alt={homeFoodSlides[0].alt} loading="lazy" />
			</div>
		</div>
	</section>

	<section class="live-section">
		<div class="container">
			<div class="live-special-feature">
				<div class="live-special-feature__image">
					<img src={easterFeature.image} alt="Savor Easter reservations artwork" loading="lazy" />
				</div>
				<div class="live-special-feature__card">
					<p class="live-special-feature__eyebrow">{easterFeature.eyebrow}</p>
					<h2>{easterFeature.title}</h2>
					<ul class="live-special-feature__details">
						{easterFeature.details.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					<div class="live-actions" style="justify-content: flex-start;">
						<a
							class="live-button"
							href={easterFeature.button.url}
							target={easterFeature.button.target}
							rel={easterFeature.button.target === "_blank" ? "noreferrer" : undefined}
						>
							{easterFeature.button.label}
						</a>
						<a class="live-button live-button--dark" href={savorSite.phoneHref}>
							Call {savorSite.phoneDisplay}
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="parallax-band" id="reviews" style={`background-image: url('${savorSite.testimonialsBackground}');`}>
		<div class="parallax-band__overlay"></div>
		<div class="container parallax-band__content">
			<div class="section-title-block section-title-block--light section-title-block--center">
				<h2>Testimonials</h2>
			</div>
			<div class="review-grid">
				{testimonials.map(({ data }) => (
					<article class="review-card">
						<div class="star-row" aria-hidden="true">
							<span class="fa fa-star"></span>
							<span class="fa fa-star"></span>
							<span class="fa fa-star"></span>
							<span class="fa fa-star"></span>
							<span class="fa fa-star"></span>
						</div>
						<p>"{data.quote}"</p>
						<h3>{data.title}</h3>
					</article>
				))}
			</div>
			<p class="reviews-links">
				More Reviews at{" "}
				<a href={savorSite.facebookUrl} target="_blank" rel="noreferrer">Facebook</a>,
				{" "}
				<a href={savorSite.tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a>,
				{" "}
				and{" "}
				<a href="https://www.google.com/search?q=savor+somerville+nj" target="_blank" rel="noreferrer">
					Google
				</a>
			</p>
		</div>
	</section>

	<section class="live-section live-section--cream">
		<div class="container">
			<div class="section-title-block section-title-block--center">
				<p class="live-tagline">About Savor Restaurant</p>
				<h2>Expert Service Staff</h2>
				<p>{homeAboutRestaurant}</p>
				<p>{homeTeamIntro}</p>
			</div>

			<div class="team-grid">
				{teamMembers.map(({ data }) => (
					<article class="team-card">
						<img src={data.image_url} alt={data.title || "Savor team member"} loading="lazy" />
						<div class="team-card__body">
							<h3>{data.title}</h3>
							<p class="team-card__role">{data.role}</p>
							<p>{data.bio}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="live-section">
		<div class="container">
			<div class="section-title-block section-title-block--center">
				<p class="live-tagline">Instagram</p>
				<h2>From the Dining Room</h2>
			</div>
			<div class="live-instagram-grid">
				{homeInstagramPosts.map((post) => (
					<article class="instagram-card">
						<img src={post.image} alt={post.caption} loading="lazy" />
						<div class="instagram-card__body">
							<p>{post.caption}</p>
							<div class="instagram-card__meta">
								<span>{post.likes} Likes</span>
								<span>{post.comments} Comments</span>
							</div>
						</div>
					</article>
				))}
			</div>
			<div class="instagram-actions">
				<a href={savorSite.instagramUrl} target="_blank" rel="noreferrer">
					Load More
				</a>
				<a href={savorSite.instagramUrl} target="_blank" rel="noreferrer">
					Follow on Instagram
				</a>
			</div>
		</div>
	</section>

	<section class="live-section live-specials" id="specials">
		<div class="container">
			<div class="section-title-block section-title-block--light section-title-block--center">
				<h2>Father's Day Specials</h2>
				<p>
					Open from Noon to 8:00 on June 18th, 2023
					<br />
					(please note this menu is in addition to our regular menu)
				</p>
			</div>
			<div class="special-course-grid">
				{menuSpecialCourses.map((course) => (
					<article class="special-course-card">
						<h3>{course.title}</h3>
						<ul>
							{course.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))}
			</div>
			<div class="live-cta-bar">
				<span>Private Events &amp; Take Out</span>
				<a href="/privateeventvenu/" data-open-inquiry>Inquire Now</a>
			</div>
		</div>
	</section>
</Base>
